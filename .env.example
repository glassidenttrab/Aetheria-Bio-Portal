# 이 파일을 복사해서 .env로 저장한 뒤 실제 값을 채우세요.
# cp .env.example .env

# Google OAuth 2.0 (Google Cloud Console > API 및 서비스 > 사용자 인증 정보)
# 로그인/회원가입은 Supabase Auth가 처리하므로, 이 Client ID/Secret은 여기 .env뿐
# 아니라 Supabase 대시보드 > Authentication > Providers > Google 에도 그대로
# 등록해야 실제로 구글 로그인이 작동한다.
VITE_GOOGLE_CLIENT_ID=
# 주의: Client Secret은 VITE_ 접두사를 붙이지 말 것. VITE_ 접두사가 붙은 값은
# 빌드 시 클라이언트 번들에 그대로 노출된다. 프론트엔드 코드에는
# Client ID만 필요하며 Secret은 Supabase 대시보드 등록용으로만 사용한다.
# GOOGLE_CLIENT_SECRET=

# Supabase (supabase.com/dashboard > 프로젝트 > Settings > API)
# 로그인/회원가입(Auth) + DB를 모두 이 프로젝트가 담당한다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Upstash Redis (upstash.com) - 현재 백엔드 서버가 없어 미사용. 향후 캐싱/레이트리밋용
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PayPal (developer.paypal.com) - 현재 Sandbox 전용
# VITE_PAYPAL_CLIENT_ID는 브라우저의 PayPal 버튼 렌더링용(공개되어도 무방).
VITE_PAYPAL_CLIENT_ID=

# ---------------------------------------------------------------------------
# 여기서부터는 서버(Vercel 서버리스 함수) 전용 값이다.
# VITE_ 접두사를 절대 붙이지 말 것 — 붙이는 순간 클라이언트 번들에 노출된다.
# 로컬 .env가 아니라 Vercel 대시보드 > Settings > Environment Variables 에
# 등록해야 배포 환경에서 동작한다.
# ---------------------------------------------------------------------------

# 결제 검증 서버가 PayPal API를 호출할 때 쓰는 자격 증명.
# VITE_PAYPAL_CLIENT_ID와 같은 값을 넣되, 서버에서 읽을 수 있도록 별도 이름으로 둔다.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET_KEY=

# sandbox | live  (미설정 시 sandbox)
PAYPAL_ENV=sandbox

# (선택) 설정하면 결제 수취인이 본인 판매자 계정인지까지 검증한다.
# PayPal 대시보드의 Merchant/Account ID.
PAYPAL_PAYEE_MERCHANT_ID=

# 결제 검증 후 플랜을 부여할 때 사용하는 Supabase 서버 자격 증명.
# service_role 키는 RLS를 우회하므로 절대 외부에 노출하면 안 된다.
# (Supabase 대시보드 > Settings > API > service_role secret)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 만료된 구독을 매일 자동으로 강등시키는 cron 엔드포인트(api/cron/expire-subscriptions.ts)
# 보호용 비밀값. 아무 값이나 긴 무작위 문자열을 넣고 Vercel에도 동일하게 등록하면,
# Vercel Cron이 호출할 때 자동으로 Authorization: Bearer <값> 헤더를 실어 보낸다.
CRON_SECRET=

# 마스터 관리자 콘솔 접근을 허용할 이메일(쉼표로 여러 개 구분).
# 이 목록에 있는 이메일로 Google/이메일 로그인해야만 관리자 콘솔에 들어갈 수 있다.
VITE_ADMIN_EMAILS=

# Sentry (sentry.io, 무료 플랜 가능) - 설정하지 않으면 에러 모니터링은 비활성 상태로 유지된다.
VITE_SENTRY_DSN=

# 이 파일을 복사해서 .env로 저장한 뒤 실제 값을 채우세요.
# cp .env.example .env

# Google OAuth 2.0 (Google Cloud Console > API 및 서비스 > 사용자 인증 정보)
# 로그인/회원가입은 Supabase Auth가 처리하므로, 이 Client ID/Secret은 여기 .env뿐
# 아니라 Supabase 대시보드 > Authentication > Providers > Google 에도 그대로
# 등록해야 실제로 구글 로그인이 작동한다.
VITE_GOOGLE_CLIENT_ID=
# 주의: Client Secret은 VITE_ 접두사를 붙이지 말 것. VITE_ 접두사가 붙은 값은
# 빌드 시 클라이언트 번들에 그대로 노출된다. 프론트엔드 코드에는
# Client ID만 필요하며 Secret은 Supabase 대시보드 등록용으로만 사용한다.
# GOOGLE_CLIENT_SECRET=

# Supabase (supabase.com/dashboard > 프로젝트 > Settings > API)
# 로그인/회원가입(Auth) + DB를 모두 이 프로젝트가 담당한다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Upstash Redis (upstash.com) - 현재 백엔드 서버가 없어 미사용. 향후 캐싱/레이트리밋용
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PayPal (developer.paypal.com) - 현재 Sandbox 전용
VITE_PAYPAL_CLIENT_ID=
PAYPAL_SECRET_KEY=

# 마스터 관리자 콘솔 접근을 허용할 이메일(쉼표로 여러 개 구분).
# 이 목록에 있는 이메일로 Google/이메일 로그인해야만 관리자 콘솔에 들어갈 수 있다.
VITE_ADMIN_EMAILS=

# Sentry (sentry.io, 무료 플랜 가능) - 설정하지 않으면 에러 모니터링은 비활성 상태로 유지된다.
VITE_SENTRY_DSN=
